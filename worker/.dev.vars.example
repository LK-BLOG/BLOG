# 本地开发用：复制本文件为 .dev.vars 并填写密码（.dev.vars 已被 git 忽略）
ADMIN_PASSWORD=你的密码
AUTH_SECRET=独立于管理员密码的长随机密钥
ADMIN_AUTH_VERSION=1
EMAIL_CODE_SECRET=随便一串够长的随机密钥
GMAIL_SCRIPT_URL=粘贴 Apps Script Web 应用 URL
GMAIL_SCRIPT_TOKEN=粘贴 Apps Script 里的 SECRET

# GitHub 登录（GitHub OAuth App 的 Client ID / Client Secret）
GITHUB_CLIENT_ID=粘贴 OAuth App 的 Client ID
GITHUB_CLIENT_SECRET=粘贴 OAuth App 的 Client Secret
# 回调地址必须和 GitHub OAuth App 里填的完全一致
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/auth/github/callback
PUBLIC_SITE_URL=http://127.0.0.1:8000
